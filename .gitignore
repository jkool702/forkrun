ring_loadables/f3
ring_loadables/f2
ring_loadables/f1
BENCHMARKS/f4
BENCHMARKS/f3
BENCHMARKS/f2
BENCHMARKS/f1
# W-REL6-2.1: local benchmark output artifact (pollutes the clean-tree
# check); regenerated by the benchmark harness, never committed.
BENCHMARKS/benchmark.out

# ---------------------------------------------------------------
# Build artifacts (never commit; every one is rebuilt by a test/CI
# path, so a committed copy is a stale copy that lies about what was
# validated).
# ---------------------------------------------------------------

# Python bytecode
__pycache__/
*.py[cod]

# Substrate canary (make -f Makefile.substrate canary)
/.canary-cc
/libforkrun.so
/libforkrun.*.so
/forkrun_ring_canary.o
/substratestubs.o

# Python frontend substrate (make -f Makefile.substrate python-substrate)
python/forkrun/libforkrun_python.so
/forkrun_python_shim.o

# Cleanroom launcher (make -f Makefile.substrate cleanroom-launcher).
# CR-FIX1-I: this was tracked at 100755. A committed executable is a
# stale copy that can be run in place of the source it was built from,
# and it is platform-specific besides. `make clean`/`clean-python`
# now remove it, so nothing rebuilds it by hand.
python/forkrun/_forkrun_cleanroom

# Python packaging artifacts (pip wheel / setup.py build; never commit)
python/forkrun.egg-info/
python/build/
python/dist/
build/
dist/
wheelhouse/
*.egg-info/

# C-plugin test suite: test_c_plugins*.sh COMPILE these at test time
# (gcc ... -o test_basic.so), COPY the header from ring_loadables/, and
# GENERATE the inputs from seq/find. Deliberately NOT a blanket "*.so" or
# "forkrun_plugin.h":
#   ring_loadables/forkrun-libs/*.so are CI-built per-arch blobs that
#   must stay tracked, and ring_loadables/forkrun_plugin.h is the frozen
#   ABI single source. A blanket rule would silently drop a newly added
#   arch's blob from a CI PR.
UNIT_TESTS/c_plugin_test/*.so
UNIT_TESTS/c_plugin_test/forkrun_plugin.h
UNIT_TESTS/c_plugin_test/input_*.txt
UNIT_TESTS/c_plugin_test/*.tmp

# Python plugin fixtures: test_plugin.py COMPILEs these at test time
python/tests/plugins/*.so

# Resume ledgers/checkpoints are per-run runtime state, not repo content
.forkrun_resume

# Stage 0 evidence harness scratch (regenerable; only results/ is committed)
python/benchmarks/stage0/inputs/
python/benchmarks/stage0/work/
python/benchmarks/stage0/logs/
python/benchmarks/stage0/*.log
# Stage 0 operational noise (run timeline + failure marker, not evidence)
python/benchmarks/stage0/results/progress.log
python/benchmarks/stage0/results/stage0_error.txt

# Editor session/swap files (never commit; W-V352-COMPLETE guardrail)
*.swp
*.kate-swp

# epyc/ real-NUMA rental harness.
#
# epyc/ itself IS tracked (it is the harness). epyc-rental-out/ is ALSO tracked:
# it holds the benchmark results, and the whole point of 98_publish.sh is to
# commit those to the results branch as each stage lands, so that a night of
# metered compute is never lost. What stays ignored is per-machine state and
# build output, none of which belongs in a results branch.
epyc-rental-out/**/*.so
epyc-rental-out/**/headline_plugins/
epyc-rental-out/**/*.i32
epyc-rental-out/**/hf_cache/
epyc-rental-out/**/ray_session*/
epyc-rental-out/**/logs/
# Machine-local run state: the recorded topology is per-box, and the stage
# markers would make the results branch depend on which box produced it.
epyc/env/epyc.env
epyc/state/
epyc/__pycache__/
epyc/blockmods/__pycache__/
# Generated C plugins from epyc/headline.py and the stage scripts
# (-march=native, so they are machine-specific build output, never source).
# Broad on purpose: narrow per-name patterns silently stop matching the moment a
# stage builds a plugin under a new name, and a binary .so committed by accident
# is a landmine in a diff.
epyc/**/*.so
epyc/**/headline_plugins/
epyc/**/ml_plugin_*.so
epyc/**/tokenize_plugin.so
# Generated ML corpora (light/medium/heavy 5M, heavy 20M) and the heavy
# plugin fixture, staged here for benchmark runs. Multi-GB derived data,
# reproducible from python/benchmarks/ml/ml_data_gen.py (SEED=42) and
# build_ml_plugin(). Ignored for the same reason as
# BENCHMARKS/benchmark.out above: they pollute the clean-tree check that
# release_check runs.
numa1/
