# MANIFEST.in — sdist contents for forkrun (W-PY23).
#
# The wheel carries a prebuilt .so, but the sdist must let anyone
# rebuild it: setup.py's build_py step runs Makefile.substrate, which
# needs the engine TU, the shim, the stubs, the plugin ABI header,
# and the makefile itself (all paths relative to the sdist root,
# mirroring the repo layout).

# C sources needed for building the substrate
include forkrun_ring.c
include forkrun_cleanroom.c
include forkrun_substrate.h
include forkrun_trace.h
# Shared build-stamp struct for the UDF helper and the cleanroom launcher.
# Both compile against it, so omitting it from the sdist breaks
# `make python-substrate` for anyone installing from source.
include forkrun_udf_version.h
include substratestubs.c
include Makefile.substrate
include ring_loadables/forkrun_plugin.h

# Python package (modules + shim source + type marker)
# *.h as well as *.c: the UDF helper (DECISION-01 Phase 2) is built from
# python/forkrun/fr_udf.c, which includes python/forkrun/fr_udf.h from
# its own directory, so shipping the sources without the header would
# make the source-only helper build fail for exactly the users it exists
# to serve.
recursive-include python/forkrun *.py *.c *.h
include python/forkrun/py.typed

# Documentation and license (PyPI page + legal)
include python/README.md
include LICENSE

# Build metadata
include pyproject.toml
include setup.py
include MANIFEST.in
