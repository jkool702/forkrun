{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode/space-bunny-free",
  "small_model": "opencode/space-bunny-free",

  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "webfetch": "deny",
    "task": "deny",

    "edit": {
      "forkrun_ring.c": "deny",
      "frun.bash": "deny",
      "META": "deny",
      "ring_loadables/*": "deny",
      "python/forkrun/*": "deny",
      "python/benchmarks/*": "deny",
      "python/tests/*": "deny",
      "epyc/validate_cells.py": "deny",
      "epyc/AGENT_PROMPT.md": "deny",
      "epyc/opencode.json": "deny",
      "epyc/state/*": "deny",
      "epyc/env/*": "deny",
      "epyc-rental-out/*": "deny",
      "*": "allow"
    },

    "bash": {
      "*": "allow",

      "git add -A*": "deny",
      "git add .*": "deny",
      "git commit -a*": "deny",
      "git reset --hard*": "deny",
      "git reset --soft*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git tag*": "deny",
      "git stash*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin NEW/*": "deny",
      "git push origin main*": "deny",
      "git push origin master*": "deny",
      "git config*": "deny",

      "rm *epyc-rental-out*": "deny",
      "rm *INTEGRITY*": "deny",
      "rm *validate_cells*": "deny",
      "rm *forkrun_ring*": "deny",
      "rm *frun.bash*": "deny",
      "rm *python/benchmarks*": "deny",
      "rm -rf .git*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "ssh*": "deny",
      "scp*": "deny"
    },

    "external_directory": "deny"
  },

  "instructions": ["epyc/AGENT_PROMPT.md"]
}
