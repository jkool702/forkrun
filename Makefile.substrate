# Stage 1 canary build (v1.3 §2.1): link-checks the substrate boundary.
# libforkrun.so must carry ZERO bash linkage — enforced by
# -Wl,--no-undefined plus an explicit allowed-dependency set.
# The canary compiles the engine TU against stub bash symbols and fails
# the build if any new bash-internal reference is introduced.
#
# Usage:
#   make -f Makefile.substrate canary   # link check only
#   make -f Makefile.substrate check    # canary + Stage-0 python tests
#   make -f Makefile.substrate canary CC=aarch64-linux-gnu-gcc OUT=libforkrun.aarch64.so
#   make -f Makefile.substrate python-substrate   # libforkrun_python.so for ctypes
#
# FALSE-GREEN GUARD: make tracks timestamps, not command lines, so switching CC
# between invocations used to leave the previous arch's objects AND output in
# place while this target (whose recipe is only an echo) still printed
# "canary OK" — reporting success for a stale artifact of the wrong arch. Two
# defenses: the CCSTAMP prerequisite forces a full rebuild whenever the
# compiler identity changes, and the arch check below refuses to report OK
# when the artifact's ELF machine doesn't match the requested compiler.
CC      ?= gcc
CFLAGS  ?= -O1 -fPIC -Wall -Wextra
INCLUDES = -I/usr/include/bash -I/usr/include/bash/include -I/usr/include/bash/builtins

# W-PY23 reproducible builds: same source + same compiler must yield
# byte-identical outputs. Three inputs defeat that by default:
#  - __FILE__ embeds the compile-time path (varies with the checkout
#    directory) -> -ffile-prefix-map pins it to ".".
#  - __DATE__/__TIME__ in forkrun_ring.c (version/debug output, engine
#    frozen — cannot remove) embed the wall clock -> predefined-macro
#    override pins them (standard reproducible-builds practice; no
#    source change, the strings are informational only).
#  - the GNU build-id hashes link inputs incl. the above -> none.
# These append (never replace) so a CC/CFLAGS override keeps working;
# setup.py's fallback gcc line mirrors them (kept in sync by
# inspection, same rule as the INCLUDES above).
CFLAGS += -ffile-prefix-map=$(CURDIR)=.
CFLAGS += -Wno-builtin-macro-redefined '-D__DATE__="Sep  1 2026"' '-D__TIME__="00:00:00"'
LDFLAGS_REPRO = -Wl,--build-id=none

OUT     ?= libforkrun.so
CCSTAMP  = .canary-cc

# Allowed shared deps for the standalone substrate (explicit set).
ALLOWED_DEPS = -ldl -lrt

CANARY_STUBS = substratestubs.o

# W-PY1 Python frontend substrate (Stage 4 Phase 1): python/forkrun/_shim.c
# textually includes forkrun_ring.c (same TU, so the engine's statics and
# TLS are visible) and ADDS non-static fr_py_* entry points for ctypes.
# forkrun_ring.c itself is unmodified. Same flags/hygiene as the canary:
# no -D_GNU_SOURCE on the CLI (the TU sets its own FTMs first).
PY_OUT ?= python/forkrun/libforkrun_python.so
PY_SHIM_OBJ = forkrun_python_shim.o

all: canary

.PHONY: all canary check clean python-substrate FORCE bench bench-small bench-large bench-csv reproducibility-check clean-python

# Rewritten only when the compiler identity/options actually change, so its
# mtime bumps exactly when dependent objects must rebuild.
$(CCSTAMP): FORCE
	@printf '%s\n' '$(CC) :: $(CFLAGS)' | cmp -s - $@ || \
		printf '%s\n' '$(CC) :: $(CFLAGS)' > $@

FORCE:

substratestubs.o: substratestubs.c forkrun_substrate.h $(CCSTAMP)
	$(CC) $(CFLAGS) -c substratestubs.c -o $@

forkrun_ring_canary.o: forkrun_ring.c forkrun_substrate.h $(CCSTAMP)
	# NOTE: no -D_GNU_SOURCE here — the TU must set its own FTMs (before any
	# libc include). A CLI define would mask exactly the include-order bug
	# class the canary exists to catch.
	$(CC) $(CFLAGS) -DSHELL -DHAVE_CONFIG_H $(INCLUDES) -c forkrun_ring.c -o $@

$(OUT): forkrun_ring_canary.o $(CANARY_STUBS)
	$(CC) -shared -o $@ forkrun_ring_canary.o $(CANARY_STUBS) \
		-Wl,--no-undefined $(ALLOWED_DEPS) $(LDFLAGS_REPRO)

forkrun_python_shim.o: python/forkrun/_shim.c forkrun_ring.c forkrun_substrate.h ring_loadables/forkrun_plugin.h $(CCSTAMP)
	# NOTE: same FTM hygiene as the canary — no -D_GNU_SOURCE on the CLI.
	# _shim.c's first directive includes forkrun_ring.c, so the engine's
	# FTM block still precedes the first libc include in this TU.
	$(CC) $(CFLAGS) -DSHELL -DHAVE_CONFIG_H $(INCLUDES) -c python/forkrun/_shim.c -o $@

$(PY_OUT): $(PY_SHIM_OBJ) $(CANARY_STUBS)
	$(CC) -shared -o $@ $(PY_SHIM_OBJ) $(CANARY_STUBS) \
		-Wl,--no-undefined $(ALLOWED_DEPS) $(LDFLAGS_REPRO)

python-substrate: $(PY_OUT)
	@file $(PY_OUT) | sed 's/^/python substrate artifact: /'
	@echo "python-substrate OK: $(PY_OUT)"

# W-PY23: two consecutive builds must be byte-identical (same
# source + same compiler). Touches the shim so both builds
# recompile+relink fully (make would otherwise no-op the second).
reproducibility-check: python-substrate
	@echo "=== Reproducibility check ($(PY_OUT)) ==="
	@sha256sum $(PY_OUT) > /tmp/fr_build1.sha
	@touch python/forkrun/_shim.c
	@$(MAKE) -f Makefile.substrate python-substrate > /dev/null
	@sha256sum $(PY_OUT) > /tmp/fr_build2.sha
	@if diff /tmp/fr_build1.sha /tmp/fr_build2.sha > /dev/null 2>&1; then \
		echo "REPRODUCIBLE: consecutive $(PY_OUT) builds are byte-identical"; \
	else \
		echo "NOT REPRODUCIBLE: builds differ:"; \
		cat /tmp/fr_build1.sha /tmp/fr_build2.sha; \
		exit 1; \
	fi
	@rm -f /tmp/fr_build1.sha /tmp/fr_build2.sha

clean-python:
	rm -f $(PY_SHIM_OBJ) $(PY_OUT) $(CCSTAMP)

bench: python-substrate
	python3 python/benchmarks/run_all.py --scale medium --trials 3

bench-small: python-substrate
	python3 python/benchmarks/run_all.py --scale small --trials 2

bench-large: python-substrate
	python3 python/benchmarks/run_all.py --scale large --trials 5

bench-csv: python-substrate
	python3 python/benchmarks/run_all.py --scale medium --trials 5 \
		--csv benchmarks/python/results_pybench.csv

canary: $(OUT)
	@file $(OUT) | sed 's/^/canary artifact: /'
	# ARCH ASSERTION uses the compiler's own TARGET TRIPLE, not its NAME:
	# pattern-matching on $(CC) false-REDs on a native aarch64 host running
	# plain `gcc` (the old *gcc* arm grepped for x86-64 and failed a correct
	# artifact). `$(CC) -dumpmachine` is the correct identity source.
	# Arches with no mapping below (ppc64le / s390x / riscv64) get the link
	# check only: on those the canary's job is -Wl,--no-undefined, not an
	# ELF-machine assertion.
	@trip="$$($(CC) -dumpmachine 2>/dev/null)"; \
	case "$$trip" in \
	  *aarch64*) want=aarch64 ;; \
	  *x86_64*)  want=x86-64 ;; \
	  *)         want="" ;; \
	esac; \
	echo "canary compiler: $(CC) -> $${trip:-unknown} (expecting ELF machine: $${want:-<link-check only>})"; \
	if [ -n "$$want" ] && ! file $(OUT) | grep -q "$$want"; then \
	  echo "canary FAIL: $(CC) targets '$$trip' but $(OUT) is not '$$want' (stale/wrong-arch artifact)" >&2; \
	  exit 1; \
	fi
	@echo "canary OK: $(OUT) links with no undefined symbols"

check: canary
	python3 -m unittest discover -s python/tests

clean:
	rm -f *.o *.so $(CCSTAMP) $(PY_SHIM_OBJ) $(PY_OUT)
